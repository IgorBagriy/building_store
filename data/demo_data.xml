        <field name="cashback_percent">0.00</field>
        <field name="credit_limit">0.00</field>
        <field name="state">new</field>
    </record>

    <!-- 4. CORE OPERATIONAL LAYER: BM.ORDER JOURNAL DOCUMENTS -->
    <record id="demo_order_done_1" model="bm.order">
        <field name="name">BS-2026-0001</field>
        <field name="partner_id" ref="demo_customer_petrenko"/>
        <field name="card_id" ref="demo_card_petrenko"/>
        <field name="state">done</field>
    </record>

    <record id="demo_order_done_2" model="bm.order">
        <field name="name">BS-2026-0002</field>
        <field name="partner_id" ref="demo_customer_ivanenko"/>
        <field name="card_id" ref="demo_card_ivanenko"/>
        <field name="state">done</field>
