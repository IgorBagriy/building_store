    <record id="demo_line_order6_plaster" model="bm.order.line">
        <field name="order_id" ref="demo_order_done_6"/>
        <field name="product_id" ref="demo_product_plaster"/>
        <field name="product_uom_qty">50.0</field>
        <field name="price_unit">320.00</field>
    </record>

    <!-- 6. SUB-LEDGER TRANSACTION FINANCIAL ENGINE (DEBT BALANCES REGISTER) -->
    <record id="demo_ledger_movement_1" model="bm.debt.ledger">
        <field name="partner_id" ref="demo_customer_petrenko"/>
        <field name="card_id" ref="demo_card_petrenko"/>
        <field name="amount">3500.00</field>
        <field name="direction">increase</field>
        <field name="res_model">bm.order</field>
        <field name="res_id" eval="ref('demo_order_done_1')"/>
    </record>

    <record id="demo_ledger_movement_2" model="bm.debt.ledger">
        <field name="partner_id" ref="demo_customer_ivanenko"/>
        <field name="card_id" ref="demo_card_ivanenko"/>
        <field name="amount">12000.00</field>
        <field name="direction">increase</field>
        <field name="res_model">bm.order</field>
        <field name="res_id" eval="ref('demo_order_done_2')"/>
    </record>

    <record id="demo_ledger_movement_3" model="bm.debt.ledger">
        <field name="partner_id" ref="demo_customer_kovalenko"/>
        <field name="card_id" ref="demo_card_kovalenko"/>
        <field name="amount">2500.00</field>
        <field name="direction">increase</field>
        <field name="res_model">bm.order</field>
        <field name="res_id" eval="ref('demo_order_done_3')"/>
    </record>

    <!-- 7. AUDIT WORKFLOW: BM.DEBT.ADJUSTMENT (BALANCES CORRECTIONS) -->
    <record id="demo_adjustment_record_1" model="bm.debt.adjustment">
        <field name="name">ADJ-2026-0001</field>
        <field name="card_id" ref="demo_card_petrenko"/>
        <field name="partner_id" ref="demo_customer_petrenko"/>
        <field name="amount">3500.00</field>
        <field name="type">increase</field>
    </record>

    <record id="demo_adjustment_record_2" model="bm.debt.adjustment">
        <field name="name">ADJ-2026-0002</field>
        <field name="card_id" ref="demo_card_ivanenko"/>
        <field name="partner_id" ref="demo_customer_ivanenko"/>
        <field name="amount">12000.00</field>
        <field name="type">increase</field>
    </record>

    <record id="demo_adjustment_record_3" model="bm.debt.adjustment">
        <field name="name">ADJ-2026-0003</field>
        <field name="card_id" ref="demo_card_kovalenko"/>
        <field name="partner_id" ref="demo_customer_kovalenko"/>
        <field name="amount">1500.00</field>
        <field name="type">decrease</field>
    </record>

     <function model="bm.loyalty.card" name="_compute_card_state">
        <value eval="[ref('demo_card_petrenko'), ref('demo_card_ivanenko'), ref('demo_card_kovalenko'), ref('demo_card_sydorenko'), ref('demo_card_moroz')]"/>
    </function>

</odoo>
