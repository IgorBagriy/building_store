    <!-- 5. TABULAR SECTIONS LAYER: BM.ORDER.LINE (SPECIFICATION LINES) -->
    <record id="demo_line_order1_cement" model="bm.order.line">
        <field name="order_id" ref="demo_order_done_1"/>
        <field name="product_id" ref="demo_product_cement"/>
        <field name="product_uom_qty">10.0</field>
        <field name="price_unit">160.00</field>
    </record>

    <record id="demo_line_order2_plaster" model="bm.order.line">
        <field name="order_id" ref="demo_order_done_2"/>
        <field name="product_id" ref="demo_product_plaster"/>
        <field name="product_uom_qty">25.0</field>
        <field name="price_unit">320.00</field>
    </record>

    <record id="demo_line_order3_roofing" model="bm.order.line">
        <field name="order_id" ref="demo_order_done_3"/>
