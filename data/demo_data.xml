    </record>

    <!-- 3. CORE PERSISTENCE LAYER: BM.LOYALTY.CARD (LIFECYCLE CONTROL) -->
    <record id="demo_card_petrenko" model="bm.loyalty.card">
        <field name="name">CARD-PET-101</field>
        <field name="partner_id" ref="demo_customer_petrenko"/>
        <field name="discount_percent">5.00</field>
        <field name="cashback_percent">3.00</field>
        <field name="credit_limit">10000.00</field>
        <field name="state">active</field>
    </record>

    <record id="demo_card_ivanenko" model="bm.loyalty.card">
        <field name="name">CARD-IVA-202</field>
        <field name="partner_id" ref="demo_customer_ivanenko"/>
        <field name="discount_percent">7.50</field>
        <field name="cashback_percent">4.00</field>
        <field name="credit_limit">25000.00</field>
        <field name="state">active</field>
    </record>

    <record id="demo_card_kovalenko" model="bm.loyalty.card">
        <field name="name">CARD-KOV-303</field>
        <field name="partner_id" ref="demo_customer_kovalenko"/>
        <field name="discount_percent">10.00</field>
        <field name="cashback_percent">5.00</field>
        <field name="credit_limit">40000.00</field>
        <field name="state">active</field>
    </record>

    <record id="demo_card_sydorenko" model="bm.loyalty.card">
        <field name="name">CARD-SYD-404</field>
