    <!-- 2. CORE PERSISTENCE LAYER: BM.PRODUCT (STORE PRODUCT CATALOGUE) -->
    <record id="demo_product_cement" model="bm.product">
        <field name="name">Cement Bag M-500 Premium 25kg</field>
        <field name="sku">SKU-CEM-001</field>
        <field name="list_price">160.00</field>
    </record>

    <record id="demo_product_plaster" model="bm.product">
        <field name="name">Knauf Gypsum Plasterboard 2500x1200x12.5mm</field>
        <field name="sku">SKU-KNF-042</field>
