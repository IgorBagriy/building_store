<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_building_store" model="ir.module.category">
            <field name="name">Building Store</field>
            <field name="description">Access control management hierarchy levels for construction retail store module.</field>
        </record>

        <record id="group_building_store_trainee" model="res.groups">
            <field name="name">Trainee Cashier</field>
            <field name="category_id" ref="module_category_building_store"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_building_store_user" model="res.groups">
            <field name="name">Cashier</field>
            <field name="category_id" ref="module_category_building_store"/>
            <field name="implied_ids" eval="[(4, ref('group_building_store_trainee'))]"/>
        </record>

        <record id="group_building_store_admin" model="res.groups">
            <field name="name">Store Administrator</field>
            <field name="category_id" ref="module_category_building_store"/>
            <field name="implied_ids" eval="[(4, ref('group_building_store_user'))]"/>
        </record>

        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('building_store.group_building_store_trainee'))]"/>
        </record>

    </data>
</odoo>
