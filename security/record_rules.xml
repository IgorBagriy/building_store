<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <record id="rule_bm_order_cashier_today" model="ir.rule">
            <field name="name">Cashier: View Today Sales Orders Only</field>
            <field name="model_id" ref="model_bm_order"/>
            <field name="domain_force">[('date_order', '&gt;=', user.create_date.now().strftime('%Y-%m-%d 00:00:00'))]</field>
            <field name="groups" eval="[(4, ref('building_store.group_building_store_trainee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_bm_order_admin_all" model="ir.rule">
            <field name="name">Administrator: View All Historical Sales Orders</field>
            <field name="model_id" ref="model_bm_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('building_store.group_building_store_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>

</odoo>
