<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bm_product_list" model="ir.ui.view">
        <field name="name">bm.product.list</field>
        <field name="model">bm.product</field>
        <field name="arch" type="xml">
            <list string="Construction Products">
                <field name="sku"/>
                <field name="name"/>
                <field name="list_price"/>
            </list>
        </field>
    </record>

    <record id="view_bm_product_form" model="ir.ui.view">
        <field name="name">bm.product.form</field>
        <field name="model">bm.product</field>
        <field name="arch" type="xml">
            <form string="Construction Product">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Product Name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Cement M-500 / Plasterboard 2500x1200x12.5"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Logistics Inventory Data">
                            <field name="sku" placeholder="e.g., ART-000123"/>
                        </group>
                        <group string="Financial Retail Commercial Pricing">
                            <field name="list_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bm_product_search" model="ir.ui.view">
        <field name="name">bm.product.search</field>
        <field name="model">bm.product</field>
        <field name="arch" type="xml">
            <search string="Search Construction Products">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('sku', 'ilike', self)]" string="Product or SKU"/>
            </search>
        </field>
    </record>

    <record id="action_bm_product" model="ir.actions.act_window">
        <field name="name">Construction Products</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">bm.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bm_product_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first store product item!
            </p>
            <p>
                Define product name, unique article barcode (SKU), and standard retail price.
            </p>
        </field>
    </record>

</odoo>
